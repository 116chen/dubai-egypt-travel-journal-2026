{
  "chapters": [
    {
      "id": "museum-chapter",
      "title": "开罗 · 大埃及博物馆",
      "heading": "开罗，先读四千年。",
      "date": "10.01",
      "subtitle": "巨像、面具与窗外的金字塔",
      "text": "从大埃及博物馆开始，先把时间往回翻。巨像站在现代屋顶下，金色面具隔着玻璃发光，窗外还能远望金字塔。真正走到金字塔脚下，是这趟旅程在开罗的最后一天。",
      "photos": [
        "p-0033",
        "p-0059",
        "p-0076"
      ],
      "readings": [
        "gem",
        "giza"
      ]
    },
    {
      "id": "aswan-chapter",
      "title": "阿斯旺 · 尼罗河神庙",
      "heading": "沿着尼罗河，看见不同年代的埃及。",
      "date": "10.03",
      "subtitle": "阿布辛贝 · 菲莱 · 科姆翁布",
      "text": "阿布辛贝把国王刻进山体，菲莱把柱廊留在水边，科姆翁布则让两位神祇共享一座神庙。沿河走，看见的是不同年代的埃及；古迹背后，还藏着现代迁建与保护的故事。",
      "photos": [
        "p-0109",
        "p-0132",
        "p-0150"
      ],
      "readings": [
        "abu",
        "philae",
        "kom"
      ]
    },
    {
      "id": "luxor-chapter",
      "title": "卢克索 · 石柱与帆船",
      "heading": "把黄昏，留给尼罗河。",
      "date": "10.04",
      "subtitle": "卡尔纳克 · 帆船 · 落日",
      "text": "白天抬头看石柱，傍晚把目光交给河面。卡尔纳克层层叠着王朝的时间，尼罗河上的帆船则把这一页慢了下来。照片里留下夕阳，也留下一起入镜的人。",
      "photos": [
        "p-0196",
        "p-0184",
        "p-0209"
      ],
      "readings": [
        "karnak",
        "luxor"
      ]
    },
    {
      "id": "dendera-chapter",
      "title": "热气球 · 帝王谷 · 丹达拉",
      "heading": "先升入天空，再走进时间深处。",
      "date": "10.05",
      "subtitle": "热气球日出 · 帝王谷 · 丹达拉",
      "text": "清晨在热气球上看日出，接着走进帝王谷墓室，再到丹达拉仰望柱头。一天里的视角，从天空落到地下，又回到高高的柱厅。墓室的颜色与神庙的浮雕，讲的是不同的故事。",
      "photos": [
        "p-0283",
        "p-0319",
        "p-0344"
      ],
      "readings": [
        "valley",
        "dendera"
      ]
    },
    {
      "id": "redsea-chapter",
      "title": "红海 · 海边慢时光",
      "heading": "到了红海，就慢下来。",
      "date": "10.05—07",
      "subtitle": "马卡迪湾 · 海岸 · 秋千",
      "text": "看完那么多石头，终于轮到海水。蓝色一层接着一层，人站在岸边，时间晃在秋千上。这几天的风景很适合放空；至于灌了几口红海水，那是另一段值得单独记下的故事。",
      "photos": [
        "p-0362",
        "p-0369",
        "p-0440"
      ],
      "readings": []
    },
    {
      "id": "giza-chapter",
      "title": "吉萨 · 开罗最后一天",
      "heading": "最后一天，站在金字塔前。",
      "date": "10.08",
      "subtitle": "10.08 · 开罗最后一天",
      "text": "金字塔，是最后一天在开罗拍的。走近后才看见石块的尺度，拉远后又看见人、骆驼与沙漠。这一站收在埃及段的末尾；当晚从开罗飞往迪拜，下一页换一座城市。",
      "photos": [
        "p-0027",
        "p-0480",
        "p-0501"
      ],
      "readings": [
        "giza",
        "cairo"
      ]
    },
    {
      "id": "dubai-chapter",
      "title": "迪拜 · 海岸与城市",
      "heading": "另一座城市，另一种时间。",
      "date": "10.09—10",
      "subtitle": "蓝水岛 · 棕榈岛 · 未来博物馆",
      "text": "海边的剪影、亚特兰蒂斯、写满阿拉伯书法的环形建筑，接上旅程的最后一章。迪拜把轮廓伸向海与天空；沿着迪拜湾回望，船、市场与贸易又讲出了高楼之前的故事。",
      "photos": [
        "p-0570",
        "p-0556",
        "p-0538",
        "p-0578"
      ],
      "readings": [
        "dubai",
        "future",
        "coast-city"
      ]
    }
  ],
  "readings": [
    {
      "id": "giza",
      "title": "金字塔不是孤立的石山",
      "era": "古王国",
      "period": "约公元前26世纪",
      "summary": "把三位国王与一整套葬祭建筑放回同一张图。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "吉萨三大金字塔分别与第四王朝的胡夫、卡夫拉和孟卡拉相联系。它们并非孤立的纪念碑，而是包含谷庙、引道、祭庙、墓园等设施的王室葬祭体系。古王国大致在公元前27至22世纪，早于这趟旅程中的拉美西斯二世与帝王谷；把年代分开，才不会把所有“法老的埃及”看成同一个时代。"
          },
          {
            "type": "citation",
            "id": "2",
            "text": "[2]"
          },
          {
            "type": "citation",
            "id": "3",
            "text": "[3]"
          },
          {
            "type": "citation",
            "id": "4",
            "text": "[4]"
          }
        ],
        [
          {
            "type": "text",
            "text": "谷庙靠近当时的水体，祭庙紧邻金字塔，两者由引道连接。这里的建筑秩序把河流、王权、太阳崇拜与来世信仰连在一起。站到狮身人面像和卡夫拉谷庙附近，再回望高地，比只看一座三角形轮廓更容易理解整个遗址。近拍石块与远拍群体也回答着不同的问题：一张说明材料与尺度，一张说明空间关系。"
          },
          {
            "type": "citation",
            "id": "2",
            "text": "[2]"
          },
          {
            "type": "citation",
            "id": "3",
            "text": "[3]"
          }
        ]
      ],
      "observations": [
        "先找金字塔、狮身人面像与低处建筑的相对位置，再看它们怎样组成整体。",
        "石块前的人、骆驼与阴影是尺度参照；照片无法单凭角度可靠确认每一座金字塔的名字。"
      ],
      "photos": [
        "p-0478",
        "p-0480",
        "p-0501"
      ]
    },
    {
      "id": "karnak",
      "title": "石柱之间，叠着许多王朝",
      "era": "新王国",
      "period": "多王朝不断增建 · 新王国尤为重要",
      "summary": "阿蒙的神庙群，是历代国王持续书写的建筑。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "卡尔纳克以阿蒙崇拜为核心，是许多王朝持续扩建的神庙群。新王国约在公元前16至11世纪，底比斯成为重要的政治和宗教中心。国王通过营建、题刻与仪式表达自己和神的关系，因此这里既有宗教空间，也有王权留下的痕迹。把它理解为一个长期生长的建筑群，会比把全部遗迹归给一位法老更准确。"
          },
          {
            "type": "citation",
            "id": "10",
            "text": "[10]"
          },
          {
            "type": "citation",
            "id": "11",
            "text": "[11]"
          },
          {
            "type": "citation",
            "id": "23",
            "text": "[23]"
          }
        ],
        [
          {
            "type": "text",
            "text": "大柱厅有134根石柱，其主体建造与装饰和塞提一世、拉美西斯二世有关。高低不同的柱列、柱头形态以及墙面浮雕，不仅制造视觉震撼，也组织了人在神圣空间里的行进与仰望。神庙的东西轴线与太阳轨迹相联系，向卢克索延伸的仪式道路则把建筑接入城市。眼前一根柱子上的图像，属于这套更大的秩序。"
          },
          {
            "type": "citation",
            "id": "10",
            "text": "[10]"
          }
        ]
      ],
      "observations": [
        "比较中央高柱与两侧柱列的高度，再看光怎样进入柱厅。",
        "留意柱头、王名圈和层层重复的人物；不必把每幅浮雕都猜成战争场面。"
      ],
      "photos": [
        "p-0184",
        "p-0240"
      ]
    },
    {
      "id": "luxor",
      "title": "一座城市，也是一条仪式路线",
      "era": "新王国",
      "period": "底比斯 · 尼罗河东岸与西岸",
      "summary": "从卡尔纳克到卢克索，神庙、河流与节日相连。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "古代底比斯的遗迹分布在尼罗河两岸。东岸的卡尔纳克与卢克索神庙是重要的宗教空间，西岸则保存王室墓地与葬祭庙。这种分布让“城市”超过了今天街道与住宅的概念：河流、仪式道路、神庙和墓地，共同组成宗教与政治生活的地理。游船从岸边经过时，看到的也是这一空间长期延续的背景。"
          },
          {
            "type": "citation",
            "id": "10",
            "text": "[10]"
          },
          {
            "type": "citation",
            "id": "11",
            "text": "[11]"
          },
          {
            "type": "citation",
            "id": "23",
            "text": "[23]"
          }
        ],
        [
          {
            "type": "text",
            "text": "卡尔纳克与卢克索神庙通过仪式道路相连，奥佩特节的仪式把两处联系起来。这样的历史背景有助于理解原行程里的神庙外观与巡城安排，但照片中的河岸建筑仍应谨慎辨认。这本手记把帆船与日落作为当日可见的记录，不凭岸边的一段轮廓断言建筑名称。历史解释提供空间关系，照片则保留具体的光与人。"
          },
          {
            "type": "citation",
            "id": "10",
            "text": "[10]"
          },
          {
            "type": "citation",
            "id": "23",
            "text": "[23]"
          }
        ]
      ],
      "observations": [
        "把河流看作连接两岸的通道，而不只是合影的背景。",
        "原单安排卢克索神庙外观；入内参观另列为可选项目，两者分别保留。"
      ],
      "photos": [
        "p-0196",
        "p-0213"
      ]
    },
    {
      "id": "valley",
      "title": "墓室的颜色，是写给来世的语言",
      "era": "新王国",
      "period": "主要为第18—20王朝",
      "summary": "进入西岸凿岩墓，读图像怎样表达死亡与重生。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "帝王谷位于尼罗河西岸，主要是新王国第18至20王朝的王室墓地，也有地位很高的非王室成员葬于此处。西方日落与死亡、重生的观念相联系；偏僻山谷中的凿岩墓，也包含对隐蔽与防盗的考虑。与古王国的地上金字塔相比，新王国把王室墓室藏入山体，葬祭庙则另设在西岸，两者有不同的空间安排。"
          },
          {
            "type": "citation",
            "id": "11",
            "text": "[11]"
          },
          {
            "type": "citation",
            "id": "12",
            "text": "[12]"
          }
        ],
        [
          {
            "type": "text",
            "text": "廊道与墓室里的文字、神祇和星空图像，常与国王在来世的行程及再生观念有关。它们有叙事和宗教功能，并非单纯用来装饰墙面的彩画。看照片时，可以先读重复的排列、人物朝向与天花板，再试着理解整条廊道的秩序。现有照片没有足够的墓号信息，这里保留“帝王谷墓室”的地点判断，不把画面擅自指定为某一座KV墓。"
          },
          {
            "type": "citation",
            "id": "11",
            "text": "[11]"
          },
          {
            "type": "citation",
            "id": "12",
            "text": "[12]"
          }
        ]
      ],
      "observations": [
        "看人物、蛇形图像、文字与星空怎样分层排列；不要只把颜色当作图案。",
        "观察长廊的连续画面，再看局部细节；这组墓室照片与丹达拉柱厅已经分别归类。"
      ],
      "photos": [
        "p-0297",
        "p-0304",
        "p-0318",
        "p-0319"
      ]
    },
    {
      "id": "abu",
      "title": "巨像、王权与一场现代迁建",
      "era": "新王国",
      "period": "约公元前13世纪 · 1968年完成迁建",
      "summary": "阿布辛贝有两段历史：凿岩营建，以及切块救援。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "阿布辛贝大神庙由第十九王朝的拉美西斯二世在约公元前13世纪营建，正面四尊巨大的坐像把国王的形象直接刻进山体。内殿把阿蒙拉、拉哈拉赫提、普塔与神化的国王并置，建筑因此同时表达神祇崇拜与王权。小神庙则与哈索尔及王后奈菲尔塔丽相关；两座神庙虽然相邻，人物与主题并不完全相同。"
          },
          {
            "type": "citation",
            "id": "5",
            "text": "[5]"
          }
        ],
        [
          {
            "type": "text",
            "text": "20世纪阿斯旺高坝的蓄水威胁努比亚古迹，国际保护行动把神庙切成石块、搬到更高处并重建，阿布辛贝在1968年完成迁建。如今见到的古建筑，也是一项现代保护工程。官方记载每年2月22日和10月22日有阳光进入内殿的现象，但不能由此确认国王的生日或登基日。这次10月3日的照片记录的是到访，没有把太阳节写成亲历。"
          },
          {
            "type": "citation",
            "id": "5",
            "text": "[5]"
          },
          {
            "type": "citation",
            "id": "6",
            "text": "[6]"
          },
          {
            "type": "citation",
            "id": "7",
            "text": "[7]"
          }
        ]
      ],
      "observations": [
        "用巨像脚边的人物比较尺度，并留意不同坐像的保存状况。",
        "从外部的王者巨像转到内殿坐像，读“国王与神祇并置”的空间关系。"
      ],
      "photos": [
        "p-0109",
        "p-0113",
        "p-0131"
      ]
    },
    {
      "id": "philae",
      "title": "换了统治者，埃及信仰仍在延续",
      "era": "希腊罗马时期",
      "period": "托勒密与罗马时期 · 20世纪迁建",
      "summary": "菲莱的伊西斯、象形文字与后来的空间改用。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "菲莱现存主要建筑属于托勒密及罗马时期，伊西斯主庙由托勒密二世开始营建，神庙还包含与荷鲁斯诞生有关的空间。希腊、罗马统治者进入埃及后，沿用本地的神祇和建筑语言来表达统治关系。因此看到熟悉的埃及浮雕，不等于眼前建筑一定属于金字塔的古王国时代；传统在不同政治时代仍不断被使用。"
          },
          {
            "type": "citation",
            "id": "8",
            "text": "[8]"
          }
        ],
        [
          {
            "type": "text",
            "text": "菲莱保存一条纪年为公元394年的象形文字铭文，后来部分建筑改作教堂，图拉真亭又留下罗马时代的建筑层次。20世纪的遗产保护行动，把古迹从原来的菲莱岛迁至阿吉勒基亚岛。今天乘船接近的柱廊，既是古代宗教延续的见证，也是迁建后的新空间；水面上的位置，已经不是古迹最初所在的岛屿。"
          },
          {
            "type": "citation",
            "id": "8",
            "text": "[8]"
          },
          {
            "type": "citation",
            "id": "7",
            "text": "[7]"
          }
        ]
      ],
      "observations": [
        "柱廊、塔门、亭子之间的差异，提示这不是一次建完的建筑群。",
        "伊西斯与丹达拉的哈索尔是不同女神；看神庙时先辨地点与供奉对象。"
      ],
      "photos": [
        "p-0132",
        "p-0137"
      ]
    },
    {
      "id": "kom",
      "title": "一座神庙，两条神圣的轴线",
      "era": "希腊罗马时期",
      "period": "现存主体为希腊罗马时期",
      "summary": "科姆翁布把索贝克与老荷鲁斯放进并列的空间。",
      "paragraphs": [
        [
          {
            "type": "text",
            "text": "科姆翁布的现存神庙主要属于希腊罗马时期，最特别的空间特征是两条平行轴线，分别通向鳄鱼神索贝克与鹰神老荷鲁斯的圣所。两位神祇共享一座建筑，又各有自己的仪式空间。原通知书中的“科孟坡”与这里使用的“科姆翁布”指同一地点；译名不同，不代表旅程另去了另一座神庙。"
          },
          {
            "type": "citation",
            "id": "9",
            "text": "[9]"
          }
        ],
        [
          {
            "type": "text",
            "text": "索贝克与水、尼罗河泛滥及丰饶有关。把鳄鱼崇拜放回河流社会的语境，会比单纯把它当作古人的奇特动物崇拜更容易理解。神庙的对称布局也不是为了今天的拍照美感，而是在建筑中安排两套神圣关系。原单还列有鳄鱼木乃伊博物馆，这里在日程中保留该安排；没有足够照片的部分，不另外编写参观体验。"
          },
          {
            "type": "citation",
            "id": "9",
            "text": "[9]"
          }
        ]
      ],
      "observations": [
        "先找两条轴线与入口的并列关系，再看柱列怎样划分庭院。",
